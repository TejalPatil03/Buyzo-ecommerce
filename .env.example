# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_EXPIRES_IN=7d

# Gemini AI Shopping Assistant
# AI Studio injects this at runtime from user secrets.
GEMINI_API_KEY=

# Application URL (AI Studio injects at runtime with Cloud Run service URL)
APP_URL=http://localhost:3000

# Database path (JSON file store)
DB_PATH=./data/buyzo_store.json
